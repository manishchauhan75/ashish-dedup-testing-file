<task id="Cleaning_the_Print_Head_Using_the_Produc" xml:lang="en-us">
   <title>Cleaning the Print Head Using the Product Control Panel</title>
   <shortdesc>You can clean the print head nozzles using the control panel on your product.</shortdesc>
  <prolog>
    <metadata>
      <keywords>
        <keyword>placeholder</keyword>
        <keyword>cleaning</keyword>
        <keyword>print</keyword>
        <keyword>Cleaning</keyword>
        <keyword>Print</keyword>
