<task id="Cleaning_the_Print_Head_Using_a_Computer" xml:lang="en-us">
   <title>Cleaning the Print Head Using a Computer Utility</title>
   <shortdesc>You can clean the print head using a utility on your Windows or Mac computer.</shortdesc>
  <prolog>
    <metadata>
      <keywords>
        <keyword>placeholder</keyword>
        <keyword>Print</keyword>
